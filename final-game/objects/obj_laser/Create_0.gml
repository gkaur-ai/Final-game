// Basic Inputs 
laser_length = 300; // Max length of laser
laser_speed = 20;	// Movement speed of laser moves 
laser_dx = lengthdir_x(1, direction); // X component for direction pointing 
laser_dy = lengthdir_y(1, direction);	// Y componemt for direction pointing 
laser_color = c_red;	// Laser color 
damage = 1;		// Damage to inflict 



